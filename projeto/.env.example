# Copie este arquivo para ".env" e preencha com as chaves do time.
# NUNCA commite o arquivo ".env" real (apenas este .env.example).

# --- Claude (Anthropic API — console.anthropic.com, NÃO é o mesmo acesso do Claude Pro/claude.ai) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini (Google AI Studio — aistudio.google.com, NÃO é o mesmo acesso do app Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# ^ confirme o nome exato do modelo disponível no momento da coleta em
#   https://ai.google.dev/gemini-api/docs/models antes de rodar a coleta final —
#   nomes de modelo da Google mudam com frequência.

# --- Jev (TypeSafe AI, via OpenRouter) ---
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-latest

# --- Parâmetros gerais de execução ---
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
LLM_TEMPERATURE=0
RANDOM_SEED=42
